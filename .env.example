# Vercel 마켓플레이스에서 Upstash Redis(또는 Vercel KV)를 연결하면
# 아래 두 값이 프로젝트 환경변수에 자동으로 추가됩니다.
# 로컬에서 테스트하려면 이 파일을 .env.local 로 복사한 뒤 값을 채워주세요.
# (또는 `vercel env pull .env.local` 명령으로 Vercel에서 바로 받아올 수 있어요)

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 관리자 페이지(/admin) 접근용 비밀번호 (선택 사항, 비워두면 잠금 없이 누구나 접근 가능)
ADMIN_PASSCODE=
